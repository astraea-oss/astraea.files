{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/lua/Desktop/Projects/astraea.files/Lua/assets/logos/red-eye-logo.png",
    "width": 24,
    "height": 12,
    "preserveAspectRatio": true
  },
  "display": {
    "color": {
      "keys": "red",
      "title": "yellow",
      "output": "bright_red",
      "separator": "bright_black"
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "yellow",
        "yellow": "bright_red",
        "red": "red"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#31}Welcome home {#33}Lua"
    },
    {
      "type": "custom",
      "format": "{#1}————————————————"
    },
    {
      "type": "custom",
      "format": "{#31}OS{#0}: CachyOS"
    },
    "uptime",
    "de",
    "wm",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery"
  ]
}
